<?xml version="1.0" encoding="utf-8" ?>
<Project
  xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <SylvanResourceTaskAssembly 
      Condition="'$(SylvanResourceTaskAssembly)' == ''">$(MSBuildThisFileDirectory)netstandard2.0/Sylvan.BuildTools.Resources.dll</SylvanResourceTaskAssembly>

    <CodeGenerationRoot>$([System.IO.Path]::Combine($(MSBuildProjectDirectory),$(IntermediateOutputPath)))/SylvanJsonResources</CodeGenerationRoot>
    <StaticResourceMarker>$(CodeGenerationRoot)/StaticResourceMarker</StaticResourceMarker>

    
  </PropertyGroup>

  <ItemDefinitionGroup>
    <JsonResource>
      <Generator>MSBuild:GenerateJsonResource</Generator>
    </JsonResource>
    <StaticResourceFiles>
      <Generator>MSBuild:GenerateStaticResource</Generator>
    </StaticResourceFiles>
  </ItemDefinitionGroup>

  <ItemGroup>
    <None Remove="**/*.resj"/>
    <JsonResource Include="**/*.resj"/>
    
    <JsonResourceCode 
      Include="@(JsonResource->'%(RecursiveDir)%(Filename)%(Extension).g.cs')"/>
    <StaticResourceRes
      Include="@(JsonResource->'%(RecursiveDir)%(Filename)%(Extension).resources')"/>
    
    <StaticResourceFiles      
      Include="%(StaticResourceFolder.Identity)/**/*"/>

  </ItemGroup>
</Project>