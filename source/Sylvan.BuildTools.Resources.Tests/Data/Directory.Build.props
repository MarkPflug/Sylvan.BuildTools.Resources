<Project>
  <PropertyGroup>
		<CodeGenTestRoot>../../../../bin/Debug/netstandard2.0/build/</CodeGenTestRoot>
		<SylvanResourceTaskAssembly>../Sylvan.BuildTools.Resources.dll</SylvanResourceTaskAssembly>
		<OutputType>Exe</OutputType>

	  <TargetFramework>net10.0</TargetFramework>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
  </PropertyGroup>

	<Import Project="$(CodeGenTestRoot)Sylvan.BuildTools.Resources.props"/>

  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)/Program+SetCulture.cs"/>
  </ItemGroup>
</Project>